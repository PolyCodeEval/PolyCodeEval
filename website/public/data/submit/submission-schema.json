{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polycodeeval.github.io/PolyCodeEval/data/submit/submission-schema.json",
  "title": "PolyCodeEval result submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkVersion",
    "level",
    "submissionName",
    "submitter",
    "method",
    "model",
    "evaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "benchmarkVersion": {
      "const": "pce-1.0"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "submissionName": {
      "type": "string",
      "minLength": 1
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github"
      ],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "affiliation": {
          "type": "string"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "paperUrl": {
          "type": "string"
        },
        "codeUrl": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "polycodeevalCommit",
        "testMode",
        "scoringMode"
      ],
      "properties": {
        "polycodeevalCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{7,40}|unknown)$"
        },
        "testMode": {
          "enum": [
            "blackbox",
            "whitebox",
            "both",
            "mixed"
          ]
        },
        "scoringMode": {
          "enum": [
            "execution",
            "correctness_only",
            "full_quality"
          ]
        },
        "command": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "packagedAt": {
          "type": "string"
        },
        "workingTreeDirty": {
          "type": "boolean"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "python": {
              "type": "string"
            },
            "docker": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "level": {
            "enum": [
              "L0",
              "L1"
            ]
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "scoringMode": {
                "enum": [
                  "correctness_only",
                  "full_quality"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "level": {
            "enum": [
              "L2",
              "L3"
            ]
          }
        },
        "required": [
          "level"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "scoringMode": {
                "const": "execution"
              }
            }
          }
        }
      }
    }
  ]
}

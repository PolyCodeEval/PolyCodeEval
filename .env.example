# PolyCodeEval LLM Configuration
# Copy this file to .env and fill in your API keys.

# --- LLM Provider for command inference (used by L0 evaluator) ---
# Supported providers: openai, anthropic
LLM_PROVIDER=anthropic

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
